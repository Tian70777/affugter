POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=humidifier
POSTGRES_USER=PGUSER
POSTGRES_PASSWORD=PGPASSWORD

SHELLY_HOST=SHELLYPLUG_HOSTNAME.local
DANISHGRID_API_KEY=API_KEY

# --- Zigbee integration ---
MQTT_HOST=localhost          # broker is on this machine (NOT "mosquitto")
# MQTT_HOST=mosquitto # hostname of the MQTT broker (docker service name)
ENABLE_ZIGBEE=false        # true where a Zigbee sensor + dongle exists
ENABLE_DHT11=true         # true where a DHT11 is wired to the Pi
